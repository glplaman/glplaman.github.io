><wx:font wx:val="宋体"/></w:rPr><w:br/><w:t> if (age &gt;= 18) {</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/></w:rPr><w:br/><w:t>        console.log(msg0);</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/></w:rPr><w:br/><w:t> } else {</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/></w:rPr><w:br/><w:t>        console.log(msg1);</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/></w:rPr><w:br/><w:t> }</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/></w:rPr><w:br/></w:r></w:p><w:p wsp:rsidR="00DC5FCE" wsp:rsidRDefault="001E71E7"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>学生答案： </w:t></w:r></w:p><w:p wsp:rsidR="00DC5FCE" wsp:rsidRDefault="001E71E7"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>针对这段代码，两种覆盖的测试用例如下：</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>1. 语句覆盖</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>要求覆盖代码中所有可执行语句，这里两个分支的 console.log 都需要被执行到：</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>测试用例1： age = 20  → 执行if分支输出 msg0 ，覆盖if分支语句</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>测试用例2： age = 16  → 执行else分支输出 msg1 ，覆盖else分支语句</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/></w:r></w:p><w:p wsp:rsidR="002B2D72" wsp:rsidRDefault="001E71E7"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>2. 分支覆盖（判定覆盖）</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>要求覆盖所有判定的所有结果（真/假都要出现），这个问题中只有一个if判定，需要覆盖判定为</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>真</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>和判定为</w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>假两种</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>情况：</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>测试用例1： age = 18  → 判定结果为真，进入if分支</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>测试用例2： age = 10  → 判定结果为假，进入else分支 </w:t></w:r></w:p><w:p wsp:rsidR="00DC5FCE" wsp:rsidRDefault="00DC5FCE"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr></w:p><w:p wsp:rsidR="00DC5FCE" wsp:rsidRDefault="001E71E7"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="宋体" w:h-ansi="宋体" w:hint="fareast"/><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>正确答案： </w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t> </w:t></w:r></w:p><w:p wsp:rsidR="00DC5FCE" wsp:rsidRDefault="001E71E7"><w:pPr><w:pStyle w:val="a3"/><w:jc w:val="left"/><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr></w:pPr><w:r><w:rPr><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>语句覆盖</w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>age = 20</w:t></w:r><w:r><w:rPr><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>，覆盖</w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t> true </w:t></w:r><w:r><w:rPr><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>分支的语句</w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/><w:t>age = 15</w:t></w:r><w:r><w:rPr><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>，覆盖</w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t> false </w:t></w:r><w:r><w:rPr><wx:font wx:val="宋体"/><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:t>分支的语句</w:t></w:r><w:r><w:rPr><w:sz w:val="21"/><w:sz-cs w:val="21"/></w:rPr><w:br/></w:r></w:p><w:p wsp:rsidR="002B2D72" wsp:rsidRDefault="001E71E7